# Local overrides for `npm run dev` / `npm run build`. Copy to .env.local (gitignored).
# Public URL of the deployed now-playing Worker, e.g. https://leoyang-now-playing.<subdomain>.workers.dev/now-playing
NEXT_PUBLIC_NOW_PLAYING_URL=

# Only needed if you run `node scripts/fetch-spotify.mjs` locally against real data.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=
